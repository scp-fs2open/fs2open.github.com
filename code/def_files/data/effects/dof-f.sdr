// Near-field depth of field: one full-resolution gather on the HDR scene colour, before bloom and
// tonemapping. The focus is at infinity, so only what is nearer than nearDist blurs (dof.h has the
// model). The sky and the cockpit stay sharp. OpenGL only.
// Limits:
// - No depth order test: a less near object can also spread a little over a nearer one.
// - An effect that writes no depth (a laser bolt, a particle, a thruster) takes the CoC of what is
//   behind it.
// - Near CoC dilation takes the largest near CoC of the tiles around a pixel (up to about 2 DOF_TILE pixels
//   farther than maxBlur, and DOF_TILE_REACH tiles at most), so a less near object beside a nearer one blurs as
//   much as the nearer one.
// The two tile passes before this one (dof-tile-f.sdr, dof-neighbor-f.sdr) find the largest near CoC of each
// tile and its neighbours, as in Call of Duty: Advanced Warfare and Unreal; a pixel in a tile with nothing near
// in reach skips the gather.
#ifdef GL_ES
precision highp float;
precision highp sampler2D;
#endif

layout(location = 0) out vec4 fragOut0;

in vec4 fragTexCoord;

uniform sampler2D tex;      // HDR scene colour
uniform sampler2D tile_tex; // the largest near CoC of the tiles around each tile (dof-neighbor-f.sdr)
#include "dof-common.sdr"

const int MAX_SAMPLES = 512; // DOF_MAX_SAMPLES in dof.h
const float GOLDEN_ANGLE = 2.39996323;

// Colour and depth must come from the same texel. Bilinear colour next to nearest depth
// lets a sharp ship's edge colour into the sky blur as a dark outline.
vec2 snap_uv(vec2 suv, vec2 texel)
{
	return (floor(suv / texel) + 0.5) * texel;
}

void main()
{
	vec2 uv = fragTexCoord.xy;
	vec2 texel = 1.0 / vec2(textureSize(depth_tex, 0));
	vec3 centre = texture(tex, uv).rgb;

	// The cockpit is nearer than any scene object, so nothing spreads over it.
	if (in_cockpit(uv)) {
		fragOut0 = vec4(centre, 1.0);
		return;
	}

	// Scatter as gather. Each blurred pixel spreads its colour over its own CoC disc with a smooth falloff,
	// 3 (1 - (r / CoC)^2)^2 times the even share, which also sums to 1 over the disc. An even disc (the
	// bokeh of a real lens) left a visible rim at the end of each halo. The taps cover a disc of the sampling
	// radius, so each tap stands for pi radius^2 / n pixels and adds that share of its own disc
	// (1 / (pi CoC^2) of it) when the disc reaches this pixel; pi cancels, so tap_area leaves it out.
	// The sum of the shares is the coverage: 1 inside a blurred object, about 0.5 at its outline, 0 at the
	// end of its reach.
	// The part that no disc covers shows what is behind the near object. That is hidden, so the farther
	// pixels within this pixel's own CoC stand for it; the cockpit is never behind anything.
	// This is the near layer (near_sum, with coverage as its alpha) over the far layer (behind), as in
	// two-layer depth of field, in one pass.

	// Near CoC dilation: every near tap spreads with the largest near CoC around this pixel, read from the
	// tile passes. The outline of a hull is its farthest part, so its CoC is small and its share (1 / CoC^2)
	// large; without the dilation the coverage reached 1 within a pixel or two inside the hull and left a
	// hard step there. The tiles see every texel, so a thin near strut is never missed, as it could be by a
	// sparse search around the pixel.
	// The raw CoCs (before the dilation) order the pixels by depth for the far layer; with the dilated value on
	// both sides, no near tap could ever be farther than this pixel.
	float c0_raw = max(coc_of(uv), 0.0);
	float c0 = c0_raw;
	float dilated = max(c0, texelFetch(tile_tex, ivec2(gl_FragCoord.xy) / DOF_TILE, 0).x);
	// Nothing near within reach: nothing spreads over this pixel.
	if (dilated <= 0.0) {
		fragOut0 = vec4(centre, 1.0);
		return;
	}
	if (c0 > 0.0) {
		c0 = dilated;
	}
	// The taps cover the dilated CoC, not maxBlur: spread over maxBlur, too few of them fell inside a small
	// disc, and a CoC under about 3 px did not blur at all.
	float radius = max(dilated, 1.0);
	// The tap count follows the area of that disc at the density of 96 taps on 16 px (dof_samples() in dof.cpp),
	// so a small disc does not read the same texels hundreds of times, and a disc keeps its density when maxBlur
	// is large. A floor of 32 keeps about one tap per pixel of a 3 px disc.
	int n = clamp(int(96.0 * (radius / 16.0) * (radius / 16.0)), 32, MAX_SAMPLES);
	float tap_area = radius * radius / float(n);
	// This pixel is a tap too; without it a near feature of one pixel can vanish at its own place.
	float coverage = c0 > 0.0 ? 3.0 * tap_area / max(c0 * c0, 1.0) : 0.0;
	vec3 near_sum = centre * coverage;
	vec3 behind_sum = vec3(0.0);
	float behind_n = 0.0;
	// Each pixel turns the spiral by its own angle (interleaved gradient noise, as in Jimenez 2014), so the
	// gaps between taps do not line up from pixel to pixel into a visible pattern.
	float spin = 6.2831853 * fract(52.9829189 * fract(dot(gl_FragCoord.xy, vec2(0.06711056, 0.00583715))));
	for (int i = 0; i < n; i++) {
		float r = radius * sqrt((float(i) + 0.5) / float(n));
		float a = float(i) * GOLDEN_ANGLE + spin;
		vec2 suv = snap_uv(uv + vec2(cos(a), sin(a)) * r * texel, texel);
		float cs_raw = coc_of(suv);
		float cs = cs_raw > 0.0 ? dilated : cs_raw;
		// Level 0 always, here and in coc_of(): the loop is not uniform across pixels, so derivatives are undefined.
		vec3 col = textureLod(tex, suv, 0.0).rgb;
		if (cs_raw >= 0.0 && cs_raw < c0_raw - 0.5 && r <= c0) {
			behind_sum += col;
			behind_n += 1.0;
		}
		if (cs <= 0.0) {
			continue;
		}
		float reach = max(cs, 1.0);
		float fall = max(1.0 - (r / reach) * (r / reach), 0.0);
		float share = 3.0 * fall * fall * tap_area / (reach * reach);
		near_sum += col * share;
		coverage += share;
	}
	if (coverage > 1.0) {
		near_sum /= coverage;
		coverage = 1.0;
	}
	vec3 behind = behind_n > 0.0 ? behind_sum / behind_n : centre;
	fragOut0 = vec4(near_sum + behind * (1.0 - coverage), 1.0);
}
