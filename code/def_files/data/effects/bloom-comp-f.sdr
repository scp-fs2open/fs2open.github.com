//? #version 150

#ifdef VULKAN
layout(location = 0) in vec2 fragTexCoord;
layout(location = 0) out vec4 fragOut0;
layout(set = 1, binding = 1) uniform sampler2D bloomed;
#else
in vec4 fragTexCoord;
out vec4 fragOut0;
uniform sampler2D bloomed;
#endif

#ifdef VULKAN
layout(std140, set = 2, binding = 0)
#else
layout(std140)
#endif
uniform genericData {
	float xSize;
	float ySize;
	float normalization;
	float bloom_intensity;
};

void main() {
	// The downsample and upsample passes keep the energy of the image, thus the
	// sum of all the mip contributions must be normalized here.
	vec3 bloom = texture(bloomed, fragTexCoord.xy).rgb;
	fragOut0.rgb = bloom * normalization;
	// The alpha channel is the blend factor between the bloom and the scene.
	fragOut0.a = bloom_intensity;
}
