layout(location = 0) in vec2 fragTexCoord;
layout(location = 0) out vec4 fragOut0;
#ifndef DEBUG_VIEW
layout(location = 1) out vec4 fragOut1;
#endif

// Scene depth, the drawn geometry's motion and cockpit depth, or just the final motion for the debug view
layout(set = 1, binding = 1) uniform sampler2D inputs[3];

layout(std140, set = 2, binding = 0) uniform genericData {
	mat4 reprojection;
	vec4 viewportRect; // xy = offset, zw = size, as fractions of the image
	float sceneNear;
	float cockpitNear;
	float farPlane;
	float cockpitDrawn;
};

void main()
{
#ifdef DEBUG_VIEW
	// Logarithmic in pixels, so that both a quarter pixel and a fast pan are visible: 1 px shows as about 0.17, 64 px as 1.
	vec2 pixels = abs(texture(inputs[0], fragTexCoord).xy) * vec2(textureSize(inputs[0], 0));
	fragOut0 = vec4(log2(1.0 + pixels) / 6.0, 0.0, 1.0);
#else
	// The scene's depth has the cockpit removed, for the effects that shouldn't see it. Consumers of motion do need it,
	// so this combines both on the cockpit's projection: its nearer plane can express every scene distance, and the
	// cockpit's own depth stays exactly as drawn.
	float sceneDepth = texture(inputs[0], fragTexCoord).r;
	float viewDepth = farPlane * sceneNear / (farPlane - sceneDepth * (farPlane - sceneNear));
	float depth = farPlane / (farPlane - cockpitNear) * (1.0 - cockpitNear / viewDepth);
	float cockpitDepth = texture(inputs[2], fragTexCoord).r;
	if (cockpitDrawn > 0.0 && cockpitDepth < 1.0) {
		depth = cockpitDepth;
	}
	fragOut1 = vec4(depth, 0.0, 0.0, 0.0);

	// Anything that didn't write its own motion still holds the clear value, so only the camera moved it.
	vec2 drawnMotion = texture(inputs[1], fragTexCoord).xy;
	if (abs(drawnMotion.x) < 100.0) {
		fragOut0 = vec4(drawnMotion, 0.0, 0.0);
		return;
	}

	// The projection maps +Y up onto the top of the image through a negative viewport height.
	vec2 viewportUv = (fragTexCoord - viewportRect.xy) / viewportRect.zw;
	vec4 ndc = vec4(viewportUv.x * 2.0 - 1.0, 1.0 - viewportUv.y * 2.0, texture(inputs[0], fragTexCoord).r, 1.0);

	vec4 previous = reprojection * ndc;
	// Behind last frame's camera, or no previous camera yet
	if (previous.w <= 0.0) {
		fragOut0 = vec4(0.0);
		return;
	}
	previous.xy /= previous.w;

	vec2 previousViewportUv = vec2(previous.x * 0.5 + 0.5, 0.5 - previous.y * 0.5);
	vec2 previousUv = previousViewportUv * viewportRect.zw + viewportRect.xy;

	fragOut0 = vec4(previousUv - fragTexCoord, 0.0, 0.0);
#endif
}
