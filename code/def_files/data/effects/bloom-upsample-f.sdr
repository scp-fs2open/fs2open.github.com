//? #version 150
#include "filter-tent.sdr"

// This shader does the upsampling of one bloom mip into the mip above it. It
// uses the Call Of Duty method, presented at ACM Siggraph 2014.

// The source texture must use a bilinear minification filter, a
// floating-point (HDR) format, and edge clamping.

#ifdef VULKAN
layout(location = 0) in vec2 fragTexCoord;
layout(location = 0) out vec4 fragOut0;
layout(set = 1, binding = 1) uniform sampler2D srcTexture;
#else
in vec4 fragTexCoord;
out vec4 fragOut0;
uniform sampler2D srcTexture;
#endif

#ifdef VULKAN
layout(std140, set = 2, binding = 0)
#else
layout(std140)
#endif
uniform genericData {
	float xSize;
	float ySize;
	float mip;
	float intensity;
};

void main()
{
	fragOut0.rgb = intensity * blur(xSize, ySize, srcTexture, mip, fragTexCoord.xy);
	fragOut0.a = 1.0;
}
